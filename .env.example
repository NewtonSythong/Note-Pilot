# Copy this file to .env and fill in real values.
#
# These were determined by reading source directly (no prior docs existed) —
# see prisma/schema.prisma for DATABASE_URL/DIRECT_URL and
# src/app/api/*/route.ts for NVIDIA_AI_API.

# Postgres connection strings (e.g. from Neon). DATABASE_URL is the pooled
# connection the running app uses; DIRECT_URL is the unpooled connection
# Prisma uses for migrations.
DATABASE_URL=
DIRECT_URL=

# OpenRouter API key (despite the name) — authenticates the AI chat /
# study-guide features against OpenRouter's API. Get one at
# https://openrouter.ai/keys.
NVIDIA_AI_API=
